# ─────────────────────────────────────────────────────────────
# Configuration d'environnement — LCDS
#
# Copier ce fichier en `shared/.env` (et lier `.env` à la racine vers lui, pour
# Docker Compose qui ne lit que la racine) :
#
#     cp .env.example shared/.env && ln -nsf shared/.env .env
#
# shared/ n'est JAMAIS versionné ni écrasé par un déploiement — voir
# readme/deploiement.md. Les valeurs par défaut correspondent à l'environnement
# Docker fourni.
# ─────────────────────────────────────────────────────────────

# Environnement : development | staging | production
# Détermine quel fichier config/environments/<env>.php est chargé.
WP_ENV='development'

# ─────────────────────────────────────────────────────────────
# Ports publiés sur l'hôte (docker-compose.yml)
# ─────────────────────────────────────────────────────────────
APP_PORT='8020'
PMA_PORT='8021'
MAILPIT_PORT='8025'
# Port MySQL exposé à l'hôte : 3307 par défaut pour ne pas entrer en conflit
# avec un MySQL local (MAMP…).
DB_PORT='3307'

# ─────────────────────────────────────────────────────────────
# URLs
# WP_HOME     = URL publique du site (sans slash final)
# WP_SITEURL  = emplacement du cœur WordPress, servi depuis /wordpress-core
# Doivent correspondre aux URLs réellement utilisées, sinon WordPress charge
# les assets sur le mauvais domaine (styles manquants, redirections en boucle).
# ─────────────────────────────────────────────────────────────
WP_HOME='http://localhost:8020'
WP_SITEURL="${WP_HOME}/wordpress-core"

# ─────────────────────────────────────────────────────────────
# Base de données (MySQL 8.4)
# DB_HOST='db' = nom du service MySQL dans docker-compose.yml.
# Hors Docker, utiliser 'localhost'.
# ─────────────────────────────────────────────────────────────
DB_NAME='lcds'
DB_USER='lcds'
DB_PASSWORD='lcds'
DB_HOST='db'
DB_ROOT_PASSWORD='root'
# DB_PREFIX='wp_'
# DB_SSL='true'

# ─────────────────────────────────────────────────────────────
# Identifiants créés au TOUT PREMIER démarrage par bin/init.sh
# (`wp core install`). Sans effet ensuite, et ignorés si un dump existant
# est importé avant le premier lancement.
# ─────────────────────────────────────────────────────────────
WP_TITLE='La Clinique du Sourire'
WP_ADMIN_USER='admin'
WP_ADMIN_PASSWORD='admin'
WP_ADMIN_EMAIL='admin@lcds.local'

# ─────────────────────────────────────────────────────────────
# Cache pleine page (WP Super Cache) — désactivé par défaut.
# Passer à 'true' définit la constante WP_CACHE ET active le plugin au
# démarrage. Voir readme/cache.md avant activation (bypass des nonces).
# ─────────────────────────────────────────────────────────────
WP_CACHE='false'

# WP-Cron : laisser 'false' en local (tâches déclenchées par le trafic).
# En PRODUCTION, passer à 'true' ET configurer un cron système, sinon les
# tâches planifiées (dont la purge des transients) ne tournent plus.
DISABLE_WP_CRON='false'

# Nombre de révisions conservées par contenu ('true' = illimité, 0 = désactivé).
# WP_POST_REVISIONS=5

# Chemin du fichier de debug (optionnel, development/staging uniquement).
# WP_DEBUG_LOG='/path/to/debug.log'

# ─────────────────────────────────────────────────────────────
# Clés et sels d'authentification — OBLIGATOIRES et UNIQUES par environnement.
# Laissés à 'generateme', ils sont générés au premier démarrage par
# bin/init.sh. En production, générer un jeu sur https://roots.io/salts.html
# Les changer invalide toutes les sessions ouvertes.
# ─────────────────────────────────────────────────────────────
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# ─────────────────────────────────────────────────────────────
# SMTP — formulaire de contact (thème, inc/contacts.php)
# Par défaut : Mailpit, le conteneur qui capture les mails. AUCUN mail ne sort
# de la machine, et tout est consultable sur http://localhost:8025
# SMTP_SECURE vide = pas de TLS (cas Mailpit).
# ─────────────────────────────────────────────────────────────
SMTP_HOST='mailpit'
SMTP_PORT='1025'
SMTP_AUTH='false'
SMTP_SECURE=''
SMTP_USERNAME=''
SMTP_PASSWORD=''
MAIL_FROM='no-reply@lcds.local'
MAIL_FROM_NAME='La Clinique du Sourire'
MAIL_TO='contact@lcds.local'

# ─────────────────────────────────────────────────────────────
# Scripts d'import de base de données (optionnel, poste de dev uniquement)
# ─────────────────────────────────────────────────────────────
PROD_HOST='your-prod-host'
PROD_USER='your-prod-user'
PROD_SITEURL='your-prod-url'
DATABASE_PROD_HOST='your-prod-db-host'
DATABASE_PROD_NAME='your-prod-db-name'
DATABASE_PROD_USER='your-prod-db-user'
DATABASE_PROD_PASSWORD='your-prod-db-password'
