{
  "preset": "per",
  "rules": {
    "phpdoc_trim": true,
    "yoda_style": {
      "equal": false,
      "identical": false,
      "less_and_greater": false
    }
  },
  "exclude": [
    "shared",
    "website/vendor",
    "website/wordpress-core",
    "website/app/plugins",
    "website/app/languages",
    "website/app/uploads",
    "website/app/mu-plugins/bedrock-disallow-indexing",
    "website/app/themes/lcds/dist",
    "website/app/themes/lcds/node_modules"
  ]
}
