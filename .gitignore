# ─────────────────────────────────────────────────────────────
# Dépendances — installées par Composer / npm, jamais versionnées
# ─────────────────────────────────────────────────────────────
/vendor/
website/vendor
website/wordpress-core
website/app/themes/lcds/node_modules
website/app/themes/lcds/dist

# ─────────────────────────────────────────────────────────────
# Environnement. En local le .env est à la racine ; sur le serveur il vit dans
# shared/ et est lié dans le docroot (website/.env). shared/ est un concept
# SERVEUR — voir readme/deploiement.md.
# ─────────────────────────────────────────────────────────────
/shared/
/.env
website/.env

# ─────────────────────────────────────────────────────────────
# Contenu applicatif
# Les plugins gratuits sont installés par Composer au build, les payants sont
# liés depuis shared/plugins/ : aucun n'est versionné.
# ─────────────────────────────────────────────────────────────
website/app/plugins
website/app/uploads/*
!website/app/uploads/.gitkeep
website/app/uploads-webpc/*
!website/app/uploads-webpc/.gitkeep
website/app/cache/*
!website/app/cache/.gitkeep
website/app/upgrade

# mu-plugins : les modules installés par Composer sont ignorés, les nôtres
# (fichier d'entrée + enums/ + cache/) sont versionnés.
website/app/mu-plugins/*/
!website/app/mu-plugins/enums/
!website/app/mu-plugins/cache/

# Drop-ins générés par WP Super Cache. À committer une fois générés si le
# cache pleine page est activé sur le projet — voir readme/cache.md.
# website/app/advanced-cache.php
# website/app/wp-cache-config.php

# ─────────────────────────────────────────────────────────────
# Environnement & secrets
# ─────────────────────────────────────────────────────────────
.env.*
!.env.example
auth.json

# Protection par mot de passe : le fichier vit dans shared/ sur le serveur,
# jamais dans le dépôt (il contient des empreintes de mots de passe).
website/.htpasswd

# Lien vers le dossier de configuration, recréé au démarrage et au déploiement.
website/config

# ─────────────────────────────────────────────────────────────
# Logs & caches d'outillage
# ─────────────────────────────────────────────────────────────
*.log
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# ─────────────────────────────────────────────────────────────
# OS / IDE
# ─────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
